{
  "name": "framebase",
  "private": true,
  "version": "0.0.0",
  "description": "Reusable frontend foundations for the Framebase ecosystem.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --filter @framebase/playground dev",
    "build": "pnpm build:packages && pnpm build:playground",
    "build:packages": "pnpm --filter @framebase/element-plus-pro-components --filter @framebase/element-plus-theme run build",
    "build:playground": "pnpm --filter @framebase/playground run build",
    "clean": "pnpm --filter @framebase/element-plus-pro-components --filter @framebase/element-plus-theme run clean",
    "typecheck": "pnpm build:packages && pnpm --filter @framebase/element-plus-pro-components --filter @framebase/element-plus-theme --filter @framebase/playground run typecheck",
    "lint": "pnpm --filter @framebase/element-plus-pro-components --filter @framebase/element-plus-theme --filter @framebase/playground run lint",
    "test": "pnpm --filter @framebase/element-plus-pro-components --filter @framebase/element-plus-theme run test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "pack:packages": "pnpm --filter @framebase/element-plus-pro-components --filter @framebase/element-plus-theme run pack:check",
    "prepare": "husky",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version && pnpm install --lockfile-only",
    "release:publish": "pnpm verify && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@element-plus/icons-vue": "2.3.1",
    "@eslint/js": "9.24.0",
    "@types/lodash-es": "4.17.12",
    "@types/node": "22.20.1",
    "@types/sortablejs": "1.15.3",
    "@vitejs/plugin-vue": "6.0.3",
    "@vitejs/plugin-vue-jsx": "5.1.3",
    "@vue/compiler-sfc": "3.5.13",
    "@vue/tsconfig": "0.7.0",
    "dayjs": "1.11.13",
    "element-plus": "2.9.7",
    "eslint": "9.24.0",
    "eslint-config-prettier": "10.1.2",
    "eslint-plugin-prettier": "5.2.6",
    "eslint-plugin-vue": "10.0.0",
    "globals": "16.0.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "lodash-es": "4.17.21",
    "prettier": "3.5.3",
    "rimraf": "3.0.2",
    "sass": "1.86.3",
    "sortablejs": "1.15.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.30.1",
    "unplugin-element-plus": "0.8.0",
    "unplugin-vue-components": "28.4.1",
    "vite": "8.0.0",
    "vitest": "1.5.0",
    "vue": "3.5.13",
    "vue-router": "4.5.0",
    "vue-tsc": "3.2.6"
  }
}
