{
  "name": "framebase",
  "private": true,
  "version": "0.0.0",
  "description": "Reusable frontend foundations for the Framebase ecosystem.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm build:packages && concurrently -n core,vue,pro,theme,playground -c blue,magenta,green,cyan,yellow \"pnpm --filter @framebase/core dev\" \"pnpm --filter @framebase/vue dev\" \"pnpm --filter @framebase/element-plus-pro-components dev\" \"pnpm --filter @framebase/element-plus-theme dev\" \"pnpm --filter @framebase/playground dev\"",
    "build": "pnpm build:packages && pnpm build:playground",
    "build:packages": "pnpm --filter @framebase/core run build && pnpm --filter @framebase/vue run build && pnpm --filter @framebase/element-plus-pro-components --filter @framebase/element-plus-theme run build",
    "build:playground": "pnpm --filter @framebase/playground run build",
    "docs:dev": "pnpm --filter @framebase/docs dev",
    "docs:build": "pnpm build:packages && pnpm --filter @framebase/docs build",
    "docs:preview": "pnpm --filter @framebase/docs preview",
    "clean": "pnpm --filter @framebase/core --filter @framebase/vue --filter @framebase/element-plus-pro-components --filter @framebase/element-plus-theme run clean",
    "typecheck": "pnpm build:packages && pnpm --filter @framebase/core --filter @framebase/vue --filter @framebase/element-plus-pro-components --filter @framebase/element-plus-theme --filter @framebase/playground run typecheck",
    "lint": "pnpm --filter @framebase/core --filter @framebase/vue --filter @framebase/element-plus-pro-components --filter @framebase/element-plus-theme --filter @framebase/playground run lint",
    "test": "pnpm --filter @framebase/core --filter @framebase/vue --filter @framebase/element-plus-pro-components --filter @framebase/element-plus-theme run test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "pack:packages": "pnpm --filter @framebase/core --filter @framebase/vue --filter @framebase/element-plus-pro-components --filter @framebase/element-plus-theme run pack:check",
    "prepare": "husky",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version && pnpm install --lockfile-only",
    "release:publish": "pnpm verify && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "@element-plus/icons-vue": "2.3.2",
    "@eslint/js": "10.0.1",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.2.0",
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vue/compiler-sfc": "3.5.41",
    "@vue/tsconfig": "0.9.1",
    "concurrently": "^10.0.4",
    "dayjs": "1.11.21",
    "element-plus": "2.14.4",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "17.3.0",
    "lodash-es": "4.18.1",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "sass": "1.102.0",
    "sortablejs": "1.15.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "unplugin-element-plus": "0.11.2",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vue": "3.5.41",
    "vue-router": "5.2.0",
    "vue-tsc": "3.3.9"
  }
}
