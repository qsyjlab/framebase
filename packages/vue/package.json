{
  "name": "@framebase/vue",
  "version": "0.1.0",
  "description": "Vue 3 composables for request, pagination, selection and URL state built on @framebase/core.",
  "license": "MIT",
  "author": "qsyjlab",
  "repository": {
    "type": "git",
    "url": "https://github.com/qsyjlab/framebase.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/qsyjlab/framebase/issues"
  },
  "homepage": "https://github.com/qsyjlab/framebase/tree/main/packages/vue",
  "keywords": [
    "vue",
    "vue3",
    "composables",
    "hooks",
    "request",
    "pagination",
    "selection",
    "url-state"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "main": "./dist/es/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.js"
    },
    "./*": {
      "types": "./dist/types/*/index.d.ts",
      "import": "./dist/es/*/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && pnpm run build:types && vite build --config vite.config.ts",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "lint": "eslint src",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "pack:check": "pnpm run verify && pnpm pack --pack-destination ../../.output/packages",
    "prepublishOnly": "pnpm run verify"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "dependencies": {
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@framebase/core": "workspace:*",
    "@types/lodash-es": "^4.17.12",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  }
}
